# Copy this file to .env and fill in your tokens.
# .env is gitignored — never commit real tokens.

# GitHub personal access token (classic or fine-grained, read-only is enough).
# Used to raise the API rate limit and read public repo/search data.
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Product Hunt developer token (free).
# Create an app at https://www.producthunt.com/v2/oauth/applications
# and use the "Developer Token" it issues.
PRODUCT_HUNT_TOKEN=

# Contact string sent in the User-Agent header to SEC EDGAR, as their
# fair-access policy requests. Any real email/URL is fine.
SEC_USER_AGENT=Startup Tracker (personal research tool) your-email@example.com
